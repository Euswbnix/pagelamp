{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PageLamp",
  "version": "0.1.0",
  "identifier": "dev.pagelamp.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs --dev && pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:sidecar && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PageLamp",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm", "appimage"],
    "publisher": "PageLamp contributors",
    "homepage": "https://github.com/Euswbnix/pagelamp",
    "category": "Education",
    "shortDescription": "Your courses, ready for the AI app you already use",
    "longDescription": "PageLamp keeps your course materials, weekly structure and deadlines on your computer and serves them over MCP to the AI app you already use (Claude Desktop, Claude Code, Codex). It never solves or submits assignments.",
    "copyright": "© 2026 PageLamp contributors",
    "license": "Apache-2.0",
    "externalBin": ["binaries/pagelamp"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QjE3OTk2QUYwNzBGMTQKUldRVUR3ZXZsbm14aHZsaWRQVU44TTBCOHg4dmFlcklSSXIzaWFZaGFNUTI5QndJRDhuc1hscisK",
      "windows": {
        "installMode": "passive"
      }
    },
    "pagelamp-updates": {
      "stable": [
        "https://raw.githubusercontent.com/Euswbnix/pagelamp/gh-pages/updates/stable.json",
        "https://euswbnix.github.io/pagelamp/updates/stable.json",
        "https://github.com/Euswbnix/pagelamp/releases/latest/download/latest.json"
      ],
      "beta": [
        "https://raw.githubusercontent.com/Euswbnix/pagelamp/gh-pages/updates/beta.json",
        "https://euswbnix.github.io/pagelamp/updates/beta.json"
      ],
      "releasePage": "https://github.com/Euswbnix/pagelamp/releases/tag/v{version}"
    }
  }
}
