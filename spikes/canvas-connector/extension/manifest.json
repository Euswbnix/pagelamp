{
  "manifest_version": 3,
  "name": "StudentOS Connector (spike)",
  "version": "0.0.1",
  "description": "SPIKE. Read-only (GET-only) copy of your own Canvas data to the StudentOS desktop app via native messaging.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "StudentOS Connector (spike)"
  }
}
